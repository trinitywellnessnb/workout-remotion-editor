{
  "name": "workout-remotion-editor-renderer",
  "private": true,
  "version": "0.1.0",
  "scripts": {
    "studio": "remotion studio workout-remotion-editor/remotion/index.ts",
    "render": "node scripts/render.mjs",
    "preflight": "node scripts/render.mjs --preflight-only",
    "fixtures": "node scripts/generate-fixtures.mjs",
    "render:fixture": "npm run fixtures && npm run render -- --timeline workout-remotion-editor/fixtures/generated/hybrid.json --output renders/workout-edit.mp4",
    "build": "remotion bundle workout-remotion-editor/remotion/index.ts dist/remotion",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "lint": "eslint workout-remotion-editor/remotion --max-warnings=0",
    "validate:render": "node scripts/validate-render.mjs",
    "validate": "npm run typecheck && npm test && npm run lint && npm run validate:render"
  },
  "dependencies": {
    "@remotion/bundler": "4.0.530",
    "@remotion/cli": "4.0.530",
    "@remotion/renderer": "4.0.530",
    "react": "19.1.1",
    "react-dom": "19.1.1",
    "remotion": "4.0.530"
  },
  "devDependencies": {
    "@eslint/js": "9.36.0",
    "@types/node": "24.5.2",
    "@types/react": "19.1.16",
    "@types/react-dom": "19.1.9",
    "eslint": "9.36.0",
    "typescript": "5.9.2",
    "typescript-eslint": "8.44.1",
    "vitest": "3.2.4"
  }
}
