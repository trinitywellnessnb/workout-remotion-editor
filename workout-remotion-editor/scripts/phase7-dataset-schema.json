{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://trinitywellnessnb.github.io/workout-remotion-editor/phase7-dataset-schema.json",
  "title": "Phase 7 repetition evaluation dataset manifest",
  "type": "object",
  "required": ["format_version", "dataset_id", "dataset_version", "footage_type", "sources"],
  "additionalProperties": false,
  "properties": {
    "format_version": {"const": "1"},
    "dataset_id": {"type": "string", "minLength": 1},
    "dataset_version": {"type": "string", "minLength": 1},
    "footage_type": {"enum": ["real", "synthetic"]},
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["source_id", "media_reference", "rights_status", "redistribution_allowed", "split", "exercise_canonical_id", "duration_seconds", "view_categories", "annotation_files", "adjudication_file"],
        "properties": {
          "source_id": {"type": "string", "minLength": 1},
          "media_reference": {"type": "string", "minLength": 1},
          "rights_status": {"const": "rights_cleared"},
          "redistribution_allowed": {"type": "boolean"},
          "split": {"enum": ["development", "held_out"]},
          "exercise_canonical_id": {"const": "dumbbell_row_single_arm"},
          "expected_side": {"enum": ["left", "right", "unknown"]},
          "duration_seconds": {"type": "number", "exclusiveMinimum": 0},
          "view_categories": {"type": "array", "minItems": 1, "items": {"type": "string"}},
          "environment_category": {"type": "string"},
          "annotation_files": {"type": "array", "minItems": 2, "items": {"type": "string", "minLength": 1}},
          "adjudication_file": {"type": "string", "minLength": 1},
          "media_sha256": {"type": "string", "pattern": "^[0-9a-f]{64}$"},
          "size_bytes": {"type": "integer", "minimum": 0},
          "notes": {"type": "string"}
        }
      }
    }
  }
}
