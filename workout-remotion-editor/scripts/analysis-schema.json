{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trinitywellnessnb/workout-remotion-editor/blob/main/workout-remotion-editor/scripts/analysis-schema.json",
  "title": "Workout Remotion Editor analysis and optional evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "sources",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.3",
        "2.4"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "quick",
            "standard",
            "extended"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string"
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "viewer_promise": {
          "type": "string",
          "minLength": 1
        },
        "primary_share_reason": {
          "enum": [
            "utility",
            "identity-community",
            "achievement-story",
            "conversation",
            "delight-craft",
            "none"
          ]
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "Seconds; null only in 2.4 when metadata is unavailable."
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "rotation": {
            "type": "number"
          },
          "video_codec": {
            "type": "string"
          },
          "audio_codec": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "notes": {
            "type": "string"
          },
          "probe_run_id": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "time_base": {
                "type": "string"
              },
              "start_time": {
                "type": "number"
              },
              "audio_streams": {
                "type": "integer",
                "minimum": 0
              },
              "variable_frame_rate": {
                "type": "boolean"
              },
              "timestamp_origin_verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timedEvent"
      }
    },
    "repetitions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/baseRange"
          },
          {
            "type": "object",
            "required": [
              "complete"
            ],
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "segment_id": {
                "type": "string"
              },
              "phase": {
                "type": "string"
              },
              "exclusion_reason": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "audio_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timedEvent"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewer_promise",
        "beats"
      ],
      "properties": {
        "viewer_promise": {
          "type": "string",
          "minLength": 1
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "primary_share_reason": {
          "enum": [
            "utility",
            "identity-community",
            "achievement-story",
            "conversation",
            "delight-craft",
            "none"
          ]
        },
        "payoff_beat_id": {
          "type": "string",
          "minLength": 1
        },
        "opening_reordered": {
          "type": "boolean"
        },
        "loop_intended": {
          "type": "boolean"
        },
        "variant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "changed_variable"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "changed_variable": {
              "type": "string",
              "minLength": 1
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/retentionBeat"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analyzerRun"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneEvidence"
          }
        },
        "scene_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneBoundary"
          }
        },
        "activity_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityRegion"
          }
        },
        "candidate_dead_time": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deadTimeCandidate"
          }
        },
        "object_detections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/objectDetection"
          }
        },
        "tracked_entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackedEntity"
          }
        },
        "entity_roles": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/entityRole"
          }
        },
        "visual_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visualRegion"
          }
        },
        "crop_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cropConstraint"
          }
        }
      }
    }
  },
  "$defs": {
    "baseRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "start",
        "end",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "segment_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "exclusion_reason": {
          "type": "string"
        }
      }
    },
    "timedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRange"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "time": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "retentionBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "timeline_start",
        "timeline_end",
        "purpose",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "hook",
            "orientation",
            "progression",
            "payoff",
            "close"
          ]
        },
        "timeline_start": {
          "type": "number",
          "minimum": 0
        },
        "timeline_end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "analyzerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "category",
        "provider",
        "version",
        "status",
        "fallback",
        "configuration",
        "warnings",
        "errors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "media_probe",
            "scene",
            "motion_activity",
            "transcript",
            "object_tracking",
            "pose",
            "action_recognition",
            "quality"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "no_results",
            "unavailable",
            "failed",
            "skipped"
          ]
        },
        "fallback": {
          "type": "boolean"
        },
        "configuration": {
          "type": "object"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "performance": {
          "type": "object",
          "additionalProperties": {
            "type": [
              "number",
              "string",
              "integer"
            ]
          }
        }
      }
    },
    "sceneEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "reason",
        "detector"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "detector": {
          "enum": [
            "content",
            "adaptive",
            "threshold"
          ]
        }
      }
    },
    "sceneBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "time",
        "reason",
        "kind",
        "detector"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "kind": {
          "enum": [
            "hard_cut_candidate",
            "fade_candidate"
          ]
        },
        "detector": {
          "enum": [
            "content",
            "adaptive",
            "threshold"
          ]
        }
      }
    },
    "activityRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "reason",
        "type",
        "threshold",
        "mean_level",
        "stream"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "type": {
          "enum": [
            "motion_active",
            "low_motion",
            "audio_active",
            "audio_inactive"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stream": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deadTimeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "reason",
        "signal_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "signal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "objectDetection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "timestamp",
        "category",
        "confidence",
        "bounding_box",
        "coordinate_space",
        "source_width",
        "source_height",
        "provider",
        "model",
        "sample_index",
        "scene_id"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "timestamp": {
          "type": "number",
          "minimum": 0
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "bounding_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "coordinate_space": {
          "const": "normalized_xyxy"
        },
        "source_width": {
          "type": "integer",
          "minimum": 1
        },
        "source_height": {
          "type": "integer",
          "minimum": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "model": {
          "type": "string",
          "minLength": 1
        },
        "sample_index": {
          "type": "integer",
          "minimum": 0
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trackedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "category",
        "provider",
        "track_id",
        "scene_id",
        "start",
        "end",
        "confidence",
        "detection_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "type": "string",
          "minLength": 1
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "track_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "detection_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "entityRole": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "role",
        "entity_id",
        "scene_id",
        "confidence",
        "ambiguous",
        "supporting_reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "role": {
          "const": "primary_athlete_candidate"
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        },
        "scene_id": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "ambiguous": {
          "type": "boolean"
        },
        "supporting_reasons": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "visualRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "type",
        "entity_ids",
        "start",
        "end",
        "bounding_box",
        "coordinate_space"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "athlete_bounding_region",
            "tracked_equipment_region",
            "athlete_equipment_union",
            "minimum_visible_region"
          ]
        },
        "entity_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "bounding_box": {
          "type": "array",
          "minItems": 4,
          "maxItems": 4,
          "items": {
            "type": "number",
            "minimum": 0,
            "maximum": 1
          }
        },
        "coordinate_space": {
          "const": "normalized_xyxy"
        }
      }
    },
    "cropConstraint": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "entity_id",
        "region_id",
        "type",
        "risk",
        "risk_reasons",
        "advisory_only"
      ],
      "properties": {
        "id": {
          "type": "string",
