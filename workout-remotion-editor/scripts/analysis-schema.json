{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trinitywellnessnb/workout-remotion-editor/blob/main/workout-remotion-editor/scripts/analysis-schema.json",
  "title": "Workout Remotion Editor analysis and optional evidence",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "project",
    "sources",
    "segments"
  ],
  "properties": {
    "schema_version": {
      "enum": [
        "2.3",
        "2.4",
        "2.5"
      ]
    },
    "project": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "title",
        "mode"
      ],
      "properties": {
        "title": {
          "type": "string",
          "minLength": 1
        },
        "mode": {
          "enum": [
            "quick",
            "standard",
            "extended"
          ]
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        },
        "fps": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "notes": {
          "type": "string"
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "viewer_promise": {
          "type": "string",
          "minLength": 1
        },
        "primary_share_reason": {
          "enum": [
            "utility",
            "identity-community",
            "achievement-story",
            "conversation",
            "delight-craft",
            "none"
          ]
        },
        "variant_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "sources": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "path",
          "duration"
        ],
        "properties": {
          "id": {
            "type": "string",
            "minLength": 1
          },
          "path": {
            "type": "string",
            "minLength": 1
          },
          "duration": {
            "type": [
              "number",
              "null"
            ],
            "exclusiveMinimum": 0,
            "description": "Seconds; null in evidence documents when metadata is unavailable."
          },
          "fps": {
            "type": "number",
            "exclusiveMinimum": 0
          },
          "width": {
            "type": "integer",
            "minimum": 1
          },
          "height": {
            "type": "integer",
            "minimum": 1
          },
          "rotation": {
            "type": "number"
          },
          "video_codec": {
            "type": "string"
          },
          "audio_codec": {
            "type": "string"
          },
          "sha256": {
            "type": "string",
            "pattern": "^[A-Fa-f0-9]{64}$"
          },
          "notes": {
            "type": "string"
          },
          "probe_run_id": {
            "type": "string",
            "minLength": 1
          },
          "metadata": {
            "type": "object",
            "additionalProperties": false,
            "properties": {
              "time_base": {
                "type": "string"
              },
              "start_time": {
                "type": "number"
              },
              "audio_streams": {
                "type": "integer",
                "minimum": 0
              },
              "variable_frame_rate": {
                "type": "boolean"
              },
              "timestamp_origin_verified": {
                "type": "boolean"
              }
            }
          }
        }
      }
    },
    "segments": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timedEvent"
      }
    },
    "repetitions": {
      "type": "array",
      "items": {
        "allOf": [
          {
            "$ref": "#/$defs/baseRange"
          },
          {
            "type": "object",
            "required": [
              "complete"
            ],
            "properties": {
              "complete": {
                "type": "boolean"
              },
              "segment_id": {
                "type": "string"
              },
              "phase": {
                "type": "string"
              },
              "exclusion_reason": {
                "type": "string"
              }
            }
          }
        ]
      }
    },
    "audio_events": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/timedEvent"
      }
    },
    "issues": {
      "type": "array",
      "items": {
        "$ref": "#/$defs/issue"
      }
    },
    "notes": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "retention_plan": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "viewer_promise",
        "beats"
      ],
      "properties": {
        "viewer_promise": {
          "type": "string",
          "minLength": 1
        },
        "target_audience": {
          "type": "string",
          "minLength": 1
        },
        "primary_share_reason": {
          "enum": [
            "utility",
            "identity-community",
            "achievement-story",
            "conversation",
            "delight-craft",
            "none"
          ]
        },
        "payoff_beat_id": {
          "type": "string",
          "minLength": 1
        },
        "opening_reordered": {
          "type": "boolean"
        },
        "loop_intended": {
          "type": "boolean"
        },
        "variant": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "id",
            "changed_variable"
          ],
          "properties": {
            "id": {
              "type": "string",
              "minLength": 1
            },
            "changed_variable": {
              "type": "string",
              "minLength": 1
            },
            "hypothesis": {
              "type": "string",
              "minLength": 1
            }
          }
        },
        "beats": {
          "type": "array",
          "minItems": 1,
          "items": {
            "$ref": "#/$defs/retentionBeat"
          }
        }
      }
    },
    "evidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "runs"
      ],
      "properties": {
        "runs": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/analyzerRun"
          }
        },
        "scenes": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneEvidence"
          }
        },
        "scene_boundaries": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/sceneBoundary"
          }
        },
        "activity_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/activityRegion"
          }
        },
        "candidate_dead_time": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/deadTimeCandidate"
          }
        },
        "tracking_intervals": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackingInterval"
          }
        },
        "detections": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/detection"
          }
        },
        "tracked_entities": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/trackedEntity"
          }
        },
        "subject_candidates": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/subjectCandidate"
          }
        },
        "visual_regions": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/visualRegion"
          }
        },
        "crop_constraints": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/cropConstraint"
          }
        }
      }
    }
  },
  "$defs": {
    "baseRange": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "start",
        "end",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        },
        "type": {
          "type": "string",
          "minLength": 1
        },
        "notes": {
          "type": "string"
        },
        "complete": {
          "type": "boolean"
        },
        "segment_id": {
          "type": "string"
        },
        "phase": {
          "type": "string"
        },
        "exclusion_reason": {
          "type": "string"
        }
      }
    },
    "timedEvent": {
      "allOf": [
        {
          "$ref": "#/$defs/baseRange"
        },
        {
          "type": "object",
          "required": [
            "type"
          ],
          "properties": {
            "type": {
              "type": "string",
              "minLength": 1
            }
          }
        }
      ]
    },
    "issue": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "severity",
        "message"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "enum": [
            "info",
            "warning",
            "error"
          ]
        },
        "message": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string"
        },
        "time": {
          "type": "number",
          "minimum": 0
        }
      }
    },
    "retentionBeat": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "timeline_start",
        "timeline_end",
        "purpose",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "type": {
          "enum": [
            "hook",
            "orientation",
            "progression",
            "payoff",
            "close"
          ]
        },
        "timeline_start": {
          "type": "number",
          "minimum": 0
        },
        "timeline_end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "purpose": {
          "type": "string",
          "minLength": 1
        },
        "evidence": {
          "type": "string",
          "minLength": 1
        },
        "hypothesis": {
          "type": "string",
          "minLength": 1
        },
        "risk": {
          "type": "string"
        },
        "confidence": {
          "enum": [
            "low",
            "medium",
            "high"
          ]
        }
      }
    },
    "analyzerRun": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "category",
        "provider",
        "version",
        "status",
        "fallback",
        "configuration",
        "warnings",
        "errors"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "media_probe",
            "scene",
            "motion_activity",
            "transcript",
            "object_tracking",
            "pose",
            "action_recognition",
            "quality"
          ]
        },
        "provider": {
          "type": "string",
          "minLength": 1
        },
        "version": {
          "type": [
            "string",
            "null"
          ]
        },
        "upstream": {
          "type": "string",
          "minLength": 1
        },
        "status": {
          "enum": [
            "success",
            "partial",
            "no_results",
            "unavailable",
            "failed",
            "skipped"
          ]
        },
        "fallback": {
          "type": "boolean"
        },
        "configuration": {
          "type": "object"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "warnings": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "errors": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "statistics": {
          "$ref": "#/$defs/runStatistics"
        }
      }
    },
    "sceneEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "reason",
        "detector"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "detector": {
          "enum": [
            "content",
            "adaptive",
            "threshold"
          ]
        }
      }
    },
    "sceneBoundary": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "time",
        "reason",
        "kind",
        "detector"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "kind": {
          "enum": [
            "hard_cut_candidate",
            "fade_candidate"
          ]
        },
        "detector": {
          "enum": [
            "content",
            "adaptive",
            "threshold"
          ]
        }
      }
    },
    "activityRegion": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "reason",
        "type",
        "threshold",
        "mean_level",
        "stream"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "type": {
          "enum": [
            "motion_active",
            "low_motion",
            "audio_active",
            "audio_inactive"
          ]
        },
        "threshold": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mean_level": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "stream": {
          "type": "integer",
          "minimum": 0
        }
      }
    },
    "deadTimeCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "reason",
        "signal_ids"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "reason": {
          "type": "string",
          "minLength": 1
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "signal_ids": {
          "type": "array",
          "minItems": 1,
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "normalizedBox": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "x1",
        "y1",
        "x2",
        "y2"
      ],
      "properties": {
        "x1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y1": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "x2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "y2": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        }
      }
    },
    "trackingInterval": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "start",
        "end",
        "sample_interval",
        "scene_id",
        "reason"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "start": {
          "type": "number",
          "minimum": 0
        },
        "end": {
          "type": "number",
          "minimum": 0
        },
        "sample_interval": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "scene_id": {
          "type": [
            "string",
            "null"
          ],
          "minLength": 1
        },
        "reason": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "detection": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "interval_id",
        "time",
        "sample_index",
        "frame_index",
        "class_id",
        "class_name",
        "category",
        "bbox",
        "confidence"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "interval_id": {
          "type": "string",
          "minLength": 1
        },
        "time": {
          "type": "number",
          "minimum": 0
        },
        "sample_index": {
          "type": "integer",
          "minimum": 0
        },
        "frame_index": {
          "type": "integer",
          "minimum": 0
        },
        "class_id": {
          "type": "integer",
          "minimum": 0
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "person",
            "object",
            "equipment",
            "unknown_equipment"
          ]
        },
        "bbox": {
          "$ref": "#/$defs/normalizedBox"
        },
        "confidence": {
          "type": [
            "number",
            "null"
          ],
          "minimum": 0,
          "maximum": 1
        },
        "entity_id": {
          "type": "string",
          "minLength": 1
        }
      }
    },
    "trackedEntity": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "interval_id",
        "provider_track_id",
        "category",
        "class_name",
        "first_seen",
        "last_seen",
        "detection_ids",
        "observation_count",
        "sample_coverage",
        "gaps",
        "issues"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "interval_id": {
          "type": "string",
          "minLength": 1
        },
        "provider_track_id": {
          "type": "string",
          "minLength": 1
        },
        "category": {
          "enum": [
            "person",
            "object",
            "equipment",
            "unknown_equipment"
          ]
        },
        "class_name": {
          "type": "string",
          "minLength": 1
        },
        "first_seen": {
          "type": "number",
          "minimum": 0
        },
        "last_seen": {
          "type": "number",
          "minimum": 0
        },
        "detection_ids": {
          "type": "array",
          "uniqueItems": true,
          "items": {
            "type": "string",
            "minLength": 1
          },
          "minItems": 1
        },
        "observation_count": {
          "type": "integer",
          "minimum": 1
        },
        "sample_coverage": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "gaps": {
          "type": "array",
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": [
              "start",
              "end",
              "reason"
            ],
            "properties": {
              "start": {
                "type": "number",
                "minimum": 0
              },
              "end": {
                "type": "number",
                "minimum": 0
              },
              "reason": {
                "type": "string",
                "minLength": 1
              }
            }
          }
        },
        "issues": {
          "type": "array",
          "items": {
            "type": "string",
            "minLength": 1
          }
        }
      }
    },
    "subjectCandidate": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "source_id",
        "run_id",
        "interval_id",
        "start",
        "end",
        "entity_id",
        "role",
        "state",
        "score",
        "score_semantics",
        "confidence",
        "signals",
        "reasons"
      ],
      "properties": {
        "id": {
          "type": "string",
          "minLength": 1
        },
        "source_id": {
          "type": "string",
          "minLength": 1
        },
        "run_id": {
          "type": "string",
          "minLength": 1
        },
        "interval_id": {
