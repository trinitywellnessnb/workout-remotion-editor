{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/trinitywellnessnb/workout-remotion-editor/blob/main/workout-remotion-editor/scripts/analysis-schema.json",
  "title": "Workout Remotion Editor analysis",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "project", "sources", "segments"],
  "properties": {
    "schema_version": {"const": "2.2"},
    "project": {
      "type": "object", "additionalProperties": false, "required": ["title", "mode"],
      "properties": {
        "title": {"type": "string", "minLength": 1},
        "mode": {"enum": ["quick", "standard", "extended"]},
        "created_at": {"type": "string", "format": "date-time"},
        "fps": {"type": "number", "exclusiveMinimum": 0},
        "notes": {"type": "string"}
      }
    },
    "sources": {
      "type": "array", "minItems": 1,
      "items": {
        "type": "object", "additionalProperties": false, "required": ["id", "path", "duration"],
        "properties": {
          "id": {"type": "string", "minLength": 1}, "path": {"type": "string", "minLength": 1},
          "duration": {"type": "number", "exclusiveMinimum": 0}, "fps": {"type": "number", "exclusiveMinimum": 0},
          "width": {"type": "integer", "minimum": 1}, "height": {"type": "integer", "minimum": 1},
          "rotation": {"type": "number"}, "video_codec": {"type": "string"}, "audio_codec": {"type": "string"},
          "sha256": {"type": "string", "pattern": "^[A-Fa-f0-9]{64}$"}, "notes": {"type": "string"}
        }
      }
    },
    "segments": {"type": "array", "items": {"$ref": "#/$defs/timedEvent"}},
    "repetitions": {
      "type": "array", "items": {
        "allOf": [{"$ref": "#/$defs/baseRange"}, {
          "type": "object", "required": ["complete"],
          "properties": {"complete": {"type": "boolean"}, "segment_id": {"type": "string"}, "phase": {"type": "string"}, "exclusion_reason": {"type": "string"}}
        }]
      }
    },
    "audio_events": {"type": "array", "items": {"$ref": "#/$defs/timedEvent"}},
    "issues": {"type": "array", "items": {"$ref": "#/$defs/issue"}},
    "notes": {"type": "array", "items": {"type": "string"}}
  },
  "$defs": {
    "baseRange": {
      "type": "object", "additionalProperties": false,
      "required": ["id", "source_id", "start", "end", "confidence"],
      "properties": {
        "id": {"type": "string", "minLength": 1}, "source_id": {"type": "string", "minLength": 1},
        "start": {"type": "number", "minimum": 0}, "end": {"type": "number", "exclusiveMinimum": 0},
        "confidence": {"enum": ["low", "medium", "high"]}, "type": {"type": "string", "minLength": 1}, "notes": {"type": "string"},
        "complete": {"type": "boolean"}, "segment_id": {"type": "string"}, "phase": {"type": "string"}, "exclusion_reason": {"type": "string"}
      }
    },
    "timedEvent": {
      "allOf": [{"$ref": "#/$defs/baseRange"}, {"type": "object", "required": ["type"], "properties": {"type": {"type": "string", "minLength": 1}}}]
    },
    "issue": {
      "type": "object", "additionalProperties": false, "required": ["id", "severity", "message"],
      "properties": {"id": {"type": "string", "minLength": 1}, "severity": {"enum": ["info", "warning", "error"]}, "message": {"type": "string", "minLength": 1}, "source_id": {"type": "string"}, "time": {"type": "number", "minimum": 0}}
    }
  }
}
